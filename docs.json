  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "body": {
      "family": "Akkurat",
      "weight": 400,
      "source": "https://static.workshop.ai/rayline/site/v2026-08-01/fonts/Akkurat-Regular-0db55ef2a5.woff2",
      "format": "woff2"
    },
    "heading": {
      "family": "Sohne",
      "weight": 600,
      "source": "https://static.workshop.ai/rayline/site/v2026-08-01/fonts/Sohne-Halbfett-9f1241e1ab.woff2",
